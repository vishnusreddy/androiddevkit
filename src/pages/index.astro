---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { SITE } from '../consts';
import { MOCK_TESTS } from '../data/mock-tests';

const topics = await getCollection('topics');
const questions = await getCollection('questions');
const experiences = (await getCollection('experiences'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const questionsFor = (topicId: string) =>
  questions.filter((q) => q.data.topic.id === topicId);
const countFor = (topicId: string) => questionsFor(topicId).length;
const idsFor = (topicId: string) => questionsFor(topicId).map((q) => q.id);

// Featured topics: most questions first, then by manual order.
const featured = [...topics]
  .sort((a, b) => {
    const diff = countFor(b.id) - countFor(a.id);
    return diff !== 0 ? diff : a.data.order - b.data.order;
  })
  .slice(0, 6);

const recentExperiences = experiences.slice(0, 3);
const recentPosts = posts.slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const outcomeClass = (o: string) =>
  o === 'Offer' ? 'out-offer' : o === 'Rejected' ? 'out-reject' : 'out-neutral';

const features = [
  {
    iconPaths: [
      'M4 19.5A2.5 2.5 0 0 1 6.5 17H20',
      'M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z',
    ],
    title: 'Topic-wise mock tests',
    body: 'Coroutines, Compose, architecture, system design - one-click tests that drill exactly the areas you are rusty on.',
  },
  {
    iconPaths: [
      'M9.09 9a3 3 0 1 1 5.83 1c0 2-3 2-3 4',
      'M12 17h.01',
      'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
    ],
    title: 'Timed full mock interviews',
    body: 'Junior, mid, and senior mocks run against the clock, so the pressure feels familiar before the real thing.',
  },
  {
    iconPaths: [
      'M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z',
      'M8 9h8',
      'M8 13h5',
    ],
    title: 'Real interview write-ups',
    body: 'First-hand accounts of actual interviews: the rounds, the questions, the hiring bar.',
  },
  {
    iconPaths: [
      'M20 6 9 17l-5-5',
    ],
    title: 'Scores and review, tracked',
    body: 'Streaks, personal bests, and a queue of missed questions to revisit - stored privately in your browser.',
  },
];
---
<BaseLayout>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <h1>Practice like it's the real interview.</h1>
        <p class="lede">
          One-click topic-wise mock tests, timed full mocks, and a question
          bank with explanations that tell you why - everything you need to
          prepare, in one place.
        </p>
        <div class="hero-choice">
          <div class="choice-panel">
            <span class="choice-eyebrow">Practice</span>
            <h2 class="choice-title">Take a mock test</h2>
            <p class="choice-body">
              Timed and scored, with topic-wise sets and full mocks that mirror
              the real interview bar.
            </p>
            <a class="btn btn-primary choice-btn" href="/tests/">
              Start a mock test
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <div class="choice-panel">
            <span class="choice-eyebrow">Prepare</span>
            <h2 class="choice-title">Study the material</h2>
            <p class="choice-body">
              A junior → mid → senior curriculum with deep lessons, then topic
              guides and explained answers when you want to drill further.
            </p>
            <a class="btn btn-outline choice-btn" href="/study/">
              Open study plan
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
        <p class="hero-meta">
          {questions.length} questions · {topics.length} topics · {MOCK_TESTS.length} structured mock tests ·
          {experiences.length} interview {experiences.length === 1 ? 'experience' : 'experiences'} ·
          no sign-up needed
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Featured topics ===== -->
  <section class="section topics-section">
    <div class="container">
      <div class="section-head">
        <h2>Brush up by topic</h2>
        <a class="see-all" href="/topics/">All topics →</a>
      </div>

      {featured.length > 0 ? (
        <div class="grid grid-3">
          {featured.map((t) => (
            <TopicCard
              href={`/topics/${t.id}/`}
              topicId={t.id}
              title={t.data.title}
              description={t.data.description}
              category={t.data.category}
              count={countFor(t.id)}
              ids={idsFor(t.id)}
            />
          ))}
        </div>
      ) : (
        <div class="empty card">
          <p>
            No topics yet - this is step one. Topics and questions get added in
            the next phase, or by the community via
            <a href={SITE.github} target="_blank" rel="noopener noreferrer"> pull requests</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== What's inside ===== -->
  <section class="section feature-band">
    <div class="container">
      <div class="feature-grid">
        {features.map((f) => (
          <div class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {f.iconPaths.map((path) => <path d={path} />)}
              </svg>
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Fresh content: experiences + blog ===== -->
  {(recentExperiences.length > 0 || recentPosts.length > 0) && (
    <section class="section">
      <div class="container fresh-grid">
        {recentExperiences.length > 0 && (
          <div class="fresh-col">
            <div class="section-head">
              <h2>Recent interviews</h2>
              <a class="see-all" href="/experiences/">All experiences →</a>
            </div>
            <div class="fresh-list">
              {recentExperiences.map((e) => (
                <a class="card fresh-row" href={`/experiences/${e.id}/`}>
                  <span class="fresh-main">
                    <span class="fresh-title">{e.data.company}</span>
                    <span class="fresh-sub">{e.data.role} · {e.data.level}</span>
                  </span>
                  <span class="fresh-side">
                    <span class:list={['out-badge', outcomeClass(e.data.outcome)]}>{e.data.outcome}</span>
                    <span class="fresh-date">{fmtDate(e.data.date)}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
        {recentPosts.length > 0 && (
          <div class="fresh-col">
            <div class="section-head">
              <h2>Guides &amp; strategy</h2>
              <a class="see-all" href="/blog/">All articles →</a>
            </div>
            <div class="fresh-list">
              {recentPosts.map((p) => (
                <a class="card fresh-row" href={`/blog/${p.id}/`}>
                  <span class="fresh-main">
                    {p.data.highlighted && <span class="fresh-highlight">★ Last-minute prep</span>}
                    <span class="fresh-title">{p.data.title}</span>
                    <span class="fresh-sub">{p.data.description}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ===== Reddit community ===== -->
  <section class="section reddit-section" aria-labelledby="reddit-heading">
    <div class="container">
      <div class="reddit-card">
        <div class="reddit-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M37.5 24.2c0-2-1.6-3.7-3.7-3.7-1 0-1.9.4-2.6 1-2-.9-4.4-1.5-7-1.6l1.5-7 4.9 1.1a3 3 0 1 0 .5-2.2l-6-1.3c-.6-.1-1.2.3-1.3.9l-1.7 8c-2.2.1-4.3.7-6.1 1.5a3.7 3.7 0 0 0-6.3 2.7c0 1.1.5 2.2 1.3 2.9v.7c0 5 5.8 9.1 13 9.1s13-4.1 13-9.1c0-.3 0-.6-.1-.9.4-.6.6-1.3.6-2.1Z" fill="white" />
            <circle cx="18.5" cy="26" r="2.1" fill="currentColor" />
            <circle cx="29.5" cy="26" r="2.1" fill="currentColor" />
            <path d="M18.5 30.4c1.5 1.4 3.3 2 5.5 2s4-.6 5.5-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="33.8" cy="11.5" r="1.8" fill="white" />
          </svg>
        </div>
        <div class="reddit-copy">
          <span class="reddit-eyebrow">r/AndroidDevKit</span>
          <h2 id="reddit-heading">There’s no need to be a lone wolf.</h2>
          <p>
            Join the AndroidDevKit community on Reddit to swap interview tips,
            ask questions, share what worked, and help shape what we build next.
          </p>
        </div>
        <a class="reddit-button" href={SITE.reddit} target="_blank" rel="noopener noreferrer">
          Join the community
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Contribute CTA ===== -->
  <section class="section contrib-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-text">
          <h2>Just finished an interview? Pay it forward.</h2>
          <p class="text-soft">
            The best prep material comes from people who just sat in the chair.
            Add a question, fix an answer, or share your interview experience.
            The guided form requires no GitHub account or Markdown.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/contribute/submit/">Contribute anonymously</a>
          <a class="btn btn-ghost" href={SITE.github} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .hero-copy {
    max-width: 760px;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero h1 {
    margin: 0;
  }
  .lede {
    margin: 1.1rem 0 0;
    font-size: 1.08rem;
    max-width: 560px;
  }
  .hero-choice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.9rem;
  }
  .choice-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.3rem, 3vw, 1.7rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .choice-panel:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow);
  }
  .choice-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .choice-title {
    margin: 0.55rem 0 0;
    font-size: 1.15rem;
  }
  .choice-body {
    margin: 0.45rem 0 1.15rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .choice-btn {
    margin-top: auto;
  }
  /* Equal-weight partner to btn-primary: clear CTA, not a muted ghost. */
  .btn-outline {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }
  .btn-outline:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .hero-meta {
    margin: 1.4rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
  }
  .see-all {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .topics-section {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .feature-band {
    border-block: 1px solid var(--border);
    background: var(--surface);
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 2.5rem;
  }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .feature-icon svg {
    width: 20px;
    height: 20px;
  }
  .feature-item h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }
  .feature-item p {
    margin: 0;
    font-size: 0.9rem;
  }

  .fresh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    align-items: start;
  }
  .fresh-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .fresh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.15rem;
  }
  .fresh-main {
    min-width: 0;
  }
  .fresh-highlight {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .fresh-title {
    display: block;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--ink);
    line-height: 1.4;
  }
  .fresh-row:hover .fresh-title {
    color: var(--accent);
  }
  .fresh-sub {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.84rem;
    color: var(--ink-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .fresh-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .fresh-date {
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .out-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .out-offer {
    color: #1f7a3d;
    background: #eaf6ef;
    border-color: #c4e6d1;
  }
  .out-reject {
    color: #9c3a2b;
    background: #f9eae6;
    border-color: #ecc9bf;
  }
  .out-neutral {
    color: var(--ink-soft);
    background: var(--surface-2);
  }
  :global(:root[data-theme='dark']) .out-offer {
    color: #7edea6;
    background: #1c2b21;
    border-color: #2c4534;
  }
  :global(:root[data-theme='dark']) .out-reject {
    color: #e5a494;
    background: #2b1c18;
    border-color: #452e27;
  }

  .contrib-section {
    padding-top: 0;
  }
  .reddit-section {
    padding-top: 0;
  }
  .reddit-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.6rem);
    padding: clamp(1.4rem, 4vw, 2rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #ff4500 24%, var(--border));
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .reddit-mark {
    display: grid;
    width: clamp(54px, 7vw, 68px);
    height: clamp(54px, 7vw, 68px);
    place-items: center;
    color: #ff4500;
  }
  .reddit-mark svg {
    width: 100%;
    height: 100%;
  }
  .reddit-copy {
    max-width: 650px;
  }
  .reddit-eyebrow {
    display: block;
    margin-bottom: 0.35rem;
    color: #d83a00;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  :global(:root[data-theme='dark']) .reddit-eyebrow {
    color: #ff7847;
  }
  .reddit-copy h2 {
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
  }
  .reddit-copy p {
    margin: 0.45rem 0 0;
    font-size: 0.92rem;
  }
  .reddit-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    border: 1px solid #ff4500;
    border-radius: var(--radius-sm);
    background: #ff4500;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .reddit-button:hover {
    border-color: #d83a00;
    background: #d83a00;
    color: #fff;
  }
  .reddit-button svg {
    width: 16px;
    height: 16px;
  }
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .cta-text {
    max-width: 560px;
  }
  .cta-text h2 {
    margin: 0 0 0.6rem;
  }
  .cta-text p {
    margin: 0;
    font-size: 0.95rem;
  }
  .cta-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .empty {
    padding: 2rem;
    text-align: center;
  }
  .empty p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .reddit-card {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .reddit-button {
      grid-column: 2;
      justify-self: start;
    }
    .cta-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-choice {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .reddit-card {
      grid-template-columns: 1fr;
    }
    .reddit-mark {
      width: 54px;
      height: 54px;
    }
    .reddit-button {
      grid-column: 1;
      width: 100%;
    }
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .choice-btn {
      width: 100%;
    }
  }
</style>
