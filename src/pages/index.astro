---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { SITE } from '../consts';

const topics = await getCollection('topics');
const questions = await getCollection('questions');
const experiences = (await getCollection('experiences'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const questionsFor = (topicId: string) =>
  questions.filter((q) => q.data.topic.id === topicId);
const countFor = (topicId: string) => questionsFor(topicId).length;
const idsFor = (topicId: string) => questionsFor(topicId).map((q) => q.id);

// Featured topics: most questions first, then by manual order.
const featured = [...topics]
  .sort((a, b) => {
    const diff = countFor(b.id) - countFor(a.id);
    return diff !== 0 ? diff : a.data.order - b.data.order;
  })
  .slice(0, 6);

const recentExperiences = experiences.slice(0, 3);
const recentPosts = posts.slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const outcomeClass = (o: string) =>
  o === 'Offer' ? 'out-offer' : o === 'Rejected' ? 'out-reject' : 'out-neutral';

const features = [
  {
    iconPaths: [
      'M4 19.5A2.5 2.5 0 0 1 6.5 17H20',
      'M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z',
    ],
    title: 'Topic-by-topic guides',
    body: 'Coroutines, Compose, architecture, system design - drill exactly the areas you are rusty on.',
  },
  {
    iconPaths: [
      'M9.09 9a3 3 0 1 1 5.83 1c0 2-3 2-3 4',
      'M12 17h.01',
      'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
    ],
    title: 'A real question bank',
    body: 'Standalone questions tagged by difficulty, each with an answer that explains the why.',
  },
  {
    iconPaths: [
      'M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z',
      'M8 9h8',
      'M8 13h5',
    ],
    title: 'Real interview write-ups',
    body: 'First-hand accounts of actual interviews: the rounds, the questions, the hiring bar.',
  },
  {
    iconPaths: [
      'M20 6 9 17l-5-5',
    ],
    title: 'Progress you can see',
    body: 'Mark questions done and save the hard ones for review - stored privately in your browser.',
  },
];
---
<BaseLayout>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <h1>Switch jobs in Android dev with zero guesswork.</h1>
        <p class="lede">
          {SITE.name} is a community-built resource with curated interview questions,
          topic deep-dives, and real interview experiences - everything you
          need to prepare, in one place.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/topics/">
            Start with topics
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="/questions/">Browse all questions</a>
        </div>
        <p class="hero-meta">
          {questions.length} questions · {topics.length} topics ·
          {experiences.length} interview {experiences.length === 1 ? 'experience' : 'experiences'} ·
          free &amp; open source, no sign-up
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Featured topics ===== -->
  <section class="section topics-section">
    <div class="container">
      <div class="section-head">
        <h2>Start with a topic</h2>
        <a class="see-all" href="/topics/">All topics →</a>
      </div>

      {featured.length > 0 ? (
        <div class="grid grid-3">
          {featured.map((t) => (
            <TopicCard
              href={`/topics/${t.id}/`}
              topicId={t.id}
              title={t.data.title}
              description={t.data.description}
              category={t.data.category}
              count={countFor(t.id)}
              ids={idsFor(t.id)}
            />
          ))}
        </div>
      ) : (
        <div class="empty card">
          <p>
            No topics yet - this is step one. Topics and questions get added in
            the next phase, or by the community via
            <a href={SITE.github} target="_blank" rel="noopener noreferrer"> pull requests</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== Practice knowledge check ===== -->
  <section class="section practice-section">
    <div class="container">
      <div class="practice-feature">
        <div class="practice-copy">
          <span class="practice-eyebrow">Practice mode</span>
          <h2>Put what you’ve learned to the test.</h2>
          <p>
            This isn’t a simulated interview. Pick a topic, difficulty, and
            session length, then use your results to see what stuck and what
            deserves another pass.
          </p>

          <ul class="practice-points">
            <li><span aria-hidden="true">✓</span> Timed 10–20 question sessions</li>
            <li><span aria-hidden="true">✓</span> MCQs and written answer practice</li>
            <li><span aria-hidden="true">✓</span> Clear scores, streaks, and personal bests</li>
          </ul>

          <a class="btn btn-primary" href="/practice/">
            Test your knowledge
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <span class="practice-note">Free · no sign-up · progress stays in your browser</span>
        </div>

        <div class="practice-preview" aria-hidden="true">
          <div class="preview-topbar">
            <div>
              <span>Question</span>
              <strong>07 <small>/ 15</small></strong>
            </div>
            <div class="preview-stats">
              <span>Streak <strong>4</strong></span>
              <span>Time <strong>12:48</strong></span>
            </div>
          </div>
          <div class="preview-progress"><span></span></div>
          <div class="preview-card">
            <div class="preview-meta">
              <span>Coroutines</span>
              <span>Senior</span>
              <em>Multiple choice</em>
            </div>
            <h3>Which scope should collect this flow?</h3>
            <div class="preview-options">
              <span><i>A</i><b></b></span>
              <span class="selected"><i>B</i><b></b></span>
              <span><i>C</i><b></b></span>
            </div>
            <div class="preview-footer">
              <span>4 answer streak</span>
              <strong>Check answer</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== What's inside ===== -->
  <section class="section feature-band">
    <div class="container">
      <div class="feature-grid">
        {features.map((f) => (
          <div class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {f.iconPaths.map((path) => <path d={path} />)}
              </svg>
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Fresh content: experiences + blog ===== -->
  {(recentExperiences.length > 0 || recentPosts.length > 0) && (
    <section class="section">
      <div class="container fresh-grid">
        {recentExperiences.length > 0 && (
          <div class="fresh-col">
            <div class="section-head">
              <h2>Recent interviews</h2>
              <a class="see-all" href="/experiences/">All experiences →</a>
            </div>
            <div class="fresh-list">
              {recentExperiences.map((e) => (
                <a class="card fresh-row" href={`/experiences/${e.id}/`}>
                  <span class="fresh-main">
                    <span class="fresh-title">{e.data.company}</span>
                    <span class="fresh-sub">{e.data.role} · {e.data.level}</span>
                  </span>
                  <span class="fresh-side">
                    <span class:list={['out-badge', outcomeClass(e.data.outcome)]}>{e.data.outcome}</span>
                    <span class="fresh-date">{fmtDate(e.data.date)}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
        {recentPosts.length > 0 && (
          <div class="fresh-col">
            <div class="section-head">
              <h2>Guides &amp; strategy</h2>
              <a class="see-all" href="/blog/">All articles →</a>
            </div>
            <div class="fresh-list">
              {recentPosts.map((p) => (
                <a class="card fresh-row" href={`/blog/${p.id}/`}>
                  <span class="fresh-main">
                    <span class="fresh-title">{p.data.title}</span>
                    <span class="fresh-sub">{p.data.description}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ===== Reddit community ===== -->
  <section class="section reddit-section" aria-labelledby="reddit-heading">
    <div class="container">
      <div class="reddit-card">
        <div class="reddit-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M37.5 24.2c0-2-1.6-3.7-3.7-3.7-1 0-1.9.4-2.6 1-2-.9-4.4-1.5-7-1.6l1.5-7 4.9 1.1a3 3 0 1 0 .5-2.2l-6-1.3c-.6-.1-1.2.3-1.3.9l-1.7 8c-2.2.1-4.3.7-6.1 1.5a3.7 3.7 0 0 0-6.3 2.7c0 1.1.5 2.2 1.3 2.9v.7c0 5 5.8 9.1 13 9.1s13-4.1 13-9.1c0-.3 0-.6-.1-.9.4-.6.6-1.3.6-2.1Z" fill="white" />
            <circle cx="18.5" cy="26" r="2.1" fill="currentColor" />
            <circle cx="29.5" cy="26" r="2.1" fill="currentColor" />
            <path d="M18.5 30.4c1.5 1.4 3.3 2 5.5 2s4-.6 5.5-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="33.8" cy="11.5" r="1.8" fill="white" />
          </svg>
        </div>
        <div class="reddit-copy">
          <span class="reddit-eyebrow">r/AndroidDevKit</span>
          <h2 id="reddit-heading">There’s no need to be a lone wolf.</h2>
          <p>
            Join the AndroidDevKit community on Reddit to swap interview tips,
            ask questions, share what worked, and help shape what we build next.
          </p>
        </div>
        <a class="reddit-button" href={SITE.reddit} target="_blank" rel="noopener noreferrer">
          Join the community
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Contribute CTA ===== -->
  <section class="section contrib-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-text">
          <h2>Just finished an interview? Pay it forward.</h2>
          <p class="text-soft">
            The best prep material comes from people who just sat in the chair.
            Add a question, fix an answer, or share your interview experience.
            The guided form requires no GitHub account or Markdown.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/contribute/submit/">Contribute anonymously</a>
          <a class="btn btn-ghost" href={SITE.github} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  :global(:root[data-theme='dark']) .hero {
    background: transparent;
  }
  .hero-copy {
    max-width: 640px;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero h1 {
    margin: 0;
  }
  .lede {
    margin: 1.1rem 0 0;
    font-size: 1.08rem;
    max-width: 560px;
  }
  .hero-cta {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.7rem;
    flex-wrap: wrap;
  }
  .hero-meta {
    margin: 1.4rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
  }
  .see-all {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .topics-section {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .practice-section {
    padding-block: 0 clamp(2.75rem, 6vw, 4.5rem);
  }
  .practice-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(390px, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .practice-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .practice-eyebrow {
    display: inline-block;
    padding: 0.28rem 0.62rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .practice-copy h2 {
    max-width: 460px;
    margin: 0.9rem 0 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    letter-spacing: -0.025em;
  }
  .practice-copy > p {
    max-width: 520px;
    margin: 0.85rem 0 0;
    font-size: 0.96rem;
  }
  .practice-points {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
    color: var(--ink-soft);
    font-size: 0.86rem;
  }
  .practice-points li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .practice-points li span {
    display: grid;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .practice-note {
    margin-top: 0.75rem;
    color: var(--ink-faint);
    font-size: 0.74rem;
  }
  .practice-preview {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: stretch;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 1px solid var(--border);
    background: var(--surface-2);
  }
  .preview-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .preview-topbar > div:first-child span,
  .preview-topbar > div:first-child strong {
    display: block;
  }
  .preview-topbar span {
    color: var(--ink-faint);
    font-size: 0.68rem;
  }
  .preview-topbar > div:first-child strong {
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1.15;
  }
  .preview-topbar small {
    color: var(--ink-faint);
    font-size: 0.7rem;
  }
  .preview-stats {
    display: flex;
    gap: 1.2rem;
  }
  .preview-stats strong {
    margin-left: 0.25rem;
    color: var(--ink);
  }
  .preview-progress {
    height: 4px;
    margin-bottom: 0.9rem;
    overflow: hidden;
    border-radius: 99px;
    background: var(--surface-3);
  }
  .preview-progress span {
    display: block;
    width: 47%;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }
  .preview-card {
    padding: clamp(1.2rem, 3vw, 1.7rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .preview-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .preview-meta span {
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 650;
  }
  .preview-meta em {
    margin-left: auto;
    color: var(--ink-faint);
    font-size: 0.63rem;
    font-style: normal;
  }
  .preview-card h3 {
    margin: 1.1rem 0;
    font-size: 1.05rem;
  }
  .preview-options {
    display: grid;
    gap: 0.55rem;
  }
  .preview-options > span {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 42px;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .preview-options > span.selected {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: var(--accent-soft);
  }
  .preview-options i {
    display: grid;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--ink-faint);
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 700;
  }
  .preview-options .selected i {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .preview-options b {
    width: min(72%, 260px);
    height: 6px;
    border-radius: 99px;
    background: var(--surface-3);
  }
  .preview-options > span:nth-child(2) b {
    width: 54%;
  }
  .preview-options > span:nth-child(3) b {
    width: 65%;
  }
  .preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .preview-footer span {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }
  .preview-footer strong {
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.68rem;
  }

  .feature-band {
    border-block: 1px solid var(--border);
    background: var(--surface);
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
  }
  :global(:root[data-theme='dark']) .feature-band {
    background: transparent;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 2.5rem;
  }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .feature-icon svg {
    width: 20px;
    height: 20px;
  }
  .feature-item h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }
  .feature-item p {
    margin: 0;
    font-size: 0.9rem;
  }

  .fresh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    align-items: start;
  }
  .fresh-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .fresh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.15rem;
  }
  .fresh-main {
    min-width: 0;
  }
  .fresh-title {
    display: block;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--ink);
    line-height: 1.4;
  }
  .fresh-row:hover .fresh-title {
    color: var(--accent);
  }
  .fresh-sub {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.84rem;
    color: var(--ink-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .fresh-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .fresh-date {
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .out-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .out-offer {
    color: #1f7a3d;
    background: #eaf6ef;
    border-color: #c4e6d1;
  }
  .out-reject {
    color: #9c3a2b;
    background: #f9eae6;
    border-color: #ecc9bf;
  }
  .out-neutral {
    color: var(--ink-soft);
    background: var(--surface-2);
  }
  :global(:root[data-theme='dark']) .out-offer {
    color: #7edea6;
    background: #1c2b21;
    border-color: #2c4534;
  }
  :global(:root[data-theme='dark']) .out-reject {
    color: #e5a494;
    background: #2b1c18;
    border-color: #452e27;
  }

  .contrib-section {
    padding-top: 0;
  }
  .reddit-section {
    padding-top: 0;
