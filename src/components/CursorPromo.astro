---
// Floating Cursor referral card. Desktop only and shown at most once per
// browser profile. The impression is recorded when the card becomes visible,
// so navigating away before the delay does not consume it. Never shown on
// /practice so it cannot interrupt a timed session.
const REFERRAL_URL = 'https://cursor.com/referral?code=IPANIIUERVMH';
---

<aside id="cursor-promo" class="cursor-promo" hidden aria-label="Cursor referral offer">
  <button id="cursor-promo-close" class="promo-close" type="button" aria-label="Dismiss this offer">
    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
  </button>
  <div class="promo-head">
    <span class="promo-logo" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26">
        <g fill="currentColor">
          <path d="M12 2 21.5 7.5 12 13 2.5 7.5Z" opacity="0.9" />
          <path d="M21.5 7.5v9L12 22v-9Z" opacity="0.38" />
          <path d="M2.5 7.5 12 13v9l-9.5-5.5Z" opacity="0.62" />
        </g>
      </svg>
    </span>
    <span class="promo-brand">Cursor</span>
  </div>
  <p class="promo-title">50% off your first month</p>
  <p class="promo-body">
    Sign up for Cursor through the AndroidDevKit referral link and your first
    month is half price. Using it supports the site, at no cost to you.
  </p>
  <a class="promo-cta" id="cursor-promo-cta" href={REFERRAL_URL} target="_blank" rel="noopener sponsored">
    Claim 50% off
  </a>
  <p class="promo-note">Referral link</p>
</aside>

<style>
  .cursor-promo {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    width: min(330px, calc(100vw - 36px));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.05rem 1.1rem 0.95rem;
    animation: cursor-promo-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .cursor-promo[hidden] {
    display: none;
  }
  @keyframes cursor-promo-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .promo-close {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 50%;
    color: var(--ink-faint);
    cursor: pointer;
  }
  .promo-close:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .promo-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .promo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .promo-logo {
    display: grid;
    place-items: center;
    color: var(--ink);
    animation: cursor-logo-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @keyframes cursor-logo-in {
    from {
      opacity: 0;
      transform: rotate(-8deg) scale(0.7);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .promo-brand {
    font-weight: 750;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .promo-title {
    margin: 0 0 0.3rem;
    font-size: 1.06rem;
    font-weight: 800;
    color: var(--ink);
  }
  .promo-body {
    margin: 0 0 0.85rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .promo-cta {
    display: block;
    text-align: center;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 750;
    font-size: 0.9rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .promo-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }
  .promo-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .promo-note {
    margin: 0.55rem 0 0;
    font-size: 0.72rem;
    text-align: center;
    color: var(--ink-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor-promo,
    .promo-logo {
      animation: none;
    }
  }
  /* Belt-and-braces: never show on small or touch screens even if the
     viewport shrinks after the card has been revealed. */
  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    .cursor-promo {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var SEEN_KEY = 'adk-cursor-promo-seen-v1';
    var LEGACY_HIDE_KEY = 'adk-cursor-promo-hide-until';
    var promo = document.getElementById('cursor-promo');
    if (!promo) return;
    if (location.pathname.indexOf('/practice') === 0) return;

    function hasSeen() {
      try {
        if (localStorage.getItem(SEEN_KEY) === '1') return true;
        if (Number(localStorage.getItem(LEGACY_HIDE_KEY) || 0) > Date.now()) {
          localStorage.setItem(SEEN_KEY, '1');
          return true;
        }
      } catch (e) {
        /* fall through to session storage */
      }
      try {
        return sessionStorage.getItem(SEEN_KEY) === '1';
      } catch (e) {
        return false;
      }
    }

    function markSeen() {
      try {
        localStorage.setItem(SEEN_KEY, '1');
      } catch (e) {
        /* session storage still prevents repeat prompts in this tab */
      }
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch (e) {
        /* ignore when storage is unavailable */
      }
    }

    if (hasSeen()) return;
    var desktopQuery = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
    if (!desktopQuery.matches) return;

    window.setTimeout(function () {
      if (!desktopQuery.matches || hasSeen()) return;
      markSeen();
      promo.hidden = false;
    }, 10000);
    document.getElementById('cursor-promo-close').addEventListener('click', function () {
      promo.hidden = true;
    });
    document.getElementById('cursor-promo-cta').addEventListener('click', function () {
      window.setTimeout(function () {
        promo.hidden = true;
      }, 400);
    });
  })();
</script>
