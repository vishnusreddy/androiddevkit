---
interface Props {
  name: 'question' | 'correction' | 'topic' | 'experience' | 'article';
}

const { name } = Astro.props;
---

<span class="contribution-icon" aria-hidden="true">
  {name === 'question' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 2-3 4"></path>
      <path d="M12 18h.01"></path>
    </svg>
  )}
  {name === 'correction' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
      <path d="m9 11 3 3L22 4"></path>
    </svg>
  )}
  {name === 'topic' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
    </svg>
  )}
  {name === 'experience' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="14" x="2" y="7" rx="2"></rect>
      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      <path d="M2 12h20"></path>
    </svg>
  )}
  {name === 'article' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <path d="M8 13h8M8 17h8M8 9h2"></path>
    </svg>
  )}
</span>

<style>
  .contribution-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  svg {
    width: 21px;
    height: 21px;
  }
</style>
