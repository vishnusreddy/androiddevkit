---
interface Props {
  location: string;
  sizes?: string;
  mobileSizes?: string;
  tabletSizes?: string;
  desktopSizes?: string;
  fluid?: boolean;
  required?: boolean;
}

const {
  location,
  sizes,
  mobileSizes,
  tabletSizes,
  desktopSizes,
  fluid,
  required,
} = Astro.props;
---

<div
  class="ezoicad ad-slot"
  data-location={location}
  data-sizes={sizes}
  data-mobile_sizes={mobileSizes}
  data-tablet_sizes={tabletSizes}
  data-desktop_sizes={desktopSizes}
  data-fluid={fluid === undefined ? undefined : String(fluid)}
  data-required={required === undefined ? undefined : String(required)}
  aria-hidden="true"
></div>

<style>
  .ad-slot:empty {
    display: none;
  }

  .ad-slot:not(:empty) {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-block: 1.75rem;
  }
</style>
