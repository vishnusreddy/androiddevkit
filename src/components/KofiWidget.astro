<style>
  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    :global([id*='kofi' i]),
    :global([class*='kofi' i]),
    :global(iframe[src*='ko-fi.com' i]) {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var desktopQuery = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
    var scriptId = 'kofi-widget-button-script';
    var hasDrawn = false;

    function drawWidget() {
      if (!desktopQuery.matches || hasDrawn) return;
      if (!window.kofiwidget2 || typeof window.kofiwidget2.init !== 'function') return;
      if (typeof window.kofiwidget2.draw !== 'function') return;

      window.kofiwidget2.init('Support me on Ko-fi', '#000000', 'B1U522TQU6');
      window.kofiwidget2.draw();
      hasDrawn = true;
    }

    function loadWidget() {
      if (!desktopQuery.matches) return;

      if (window.kofiwidget2) {
        drawWidget();
        return;
      }

      var existingScript = document.getElementById(scriptId);
      if (existingScript) {
        existingScript.addEventListener('load', drawWidget, { once: true });
        return;
      }

      var script = document.createElement('script');
      script.id = scriptId;
      script.src = 'https://storage.ko-fi.com/cdn/widget/Widget_2.js';
      script.async = true;
      script.addEventListener('load', drawWidget);
      document.body.appendChild(script);
    }

    loadWidget();
    desktopQuery.addEventListener('change', function (event) {
      if (event.matches) loadWidget();
    });
  })();
</script>
