---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { NAV_GROUPS, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const groupActive = (items: { href: string }[]) =>
  items.some((i) => isActive(i.href));
---
<header class="site-header">
  <div class="container header-inner">
    <Logo />

    <nav class="nav-desktop" aria-label="Primary">
      {NAV_GROUPS.map((group) =>
        group.items ? (
          <div class="nav-group">
            <button
              type="button"
              class:list={['nav-link nav-group-btn', { active: groupActive(group.items) }]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.label}
              <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="nav-menu" role="menu">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  role="menuitem"
                  class:list={['nav-menu-item', { active: isActive(item.href) }]}
                >
                  <span class="nav-menu-label">{item.label}</span>
                  {item.desc && <span class="nav-menu-desc">{item.desc}</span>}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={group.href}
            class:list={['nav-link', { active: isActive(group.href) }]}
          >
            {group.label}
          </a>
        ),
      )}
    </nav>

    <div class="header-actions">
      <SearchBar />
      <a
        class="github-link"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.2c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
        </svg>
      </a>
      <ThemeToggle />
      <button id="menu-btn" class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Mobile" hidden>
    {NAV_GROUPS.map((group) =>
      group.items ? (
        <div class="mobile-group">
          <span class="mobile-group-label">{group.label}</span>
          {group.items.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          ))}
        </div>
      ) : (
        <a
          href={group.href}
          class:list={['nav-link mobile-top', { active: isActive(group.href) }]}
        >
          {group.label}
        </a>
      ),
    )}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    margin-right: 0.5rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  /* Dropdown groups */
  .nav-group {
    position: relative;
  }
  .nav-group-btn {
    font-family: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .chev {
    transition: transform 0.18s ease;
    opacity: 0.7;
  }
  .nav-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 14px);
    box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  /* A hover bridge so the menu doesn't close in the 8px gap */
  .nav-menu::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }
  .nav-group:hover .nav-menu,
  .nav-group:focus-within .nav-menu,
  .nav-group[data-open='true'] .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-group:hover .chev,
  .nav-group:focus-within .chev,
  .nav-group[data-open='true'] .chev {
    transform: rotate(180deg);
  }
  .nav-menu-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 9px;
    transition: background 0.14s ease;
  }
  .nav-menu-item:hover {
    background: var(--surface-2);
  }
  .nav-menu-label {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .nav-menu-item.active .nav-menu-label {
    color: var(--accent);
  }
  .nav-menu-desc {
    color: var(--ink-faint);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--ink-soft);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .github-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1rem;
    border-top: 1px solid var(--border);
    gap: 0.15rem;
  }
  .nav-mobile .nav-link {
    padding: 0.7rem 0.5rem;
    font-size: 1rem;
  }
  .mobile-group {
    display: flex;
    flex-direction: column;
    padding-top: 0.35rem;
  }
  .mobile-group-label {
    padding: 0.6rem 0.5rem 0.15rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .mobile-group .nav-link {
    padding-left: 0.9rem;
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .github-link {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .nav-mobile[data-open='true'] {
      display: flex;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    const next = !open;
    nav?.setAttribute('data-open', String(next));
    if (next) {
      nav?.removeAttribute('hidden');
    }
    btn.setAttribute('aria-expanded', String(next));
  });

  // Desktop dropdowns: hover/focus is handled by CSS; JS adds click/tap
  // toggling (touch devices, keyboard), outside-click / Escape dismissal, and
  // arrow-key roving focus through the menu items.
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.nav-group'));
  const closeAll = (except?: HTMLElement) => {
    for (const g of groups) {
      if (g === except) continue;
      g.removeAttribute('data-open');
      g.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'false');
    }
  };

  const openGroup = (group: HTMLElement) => {
    closeAll(group);
    group.setAttribute('data-open', 'true');
    group.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'true');
  };
  const closeGroup = (group: HTMLElement, focusBtn = false) => {
    group.removeAttribute('data-open');
    const btn = group.querySelector<HTMLButtonElement>('.nav-group-btn');
    btn?.setAttribute('aria-expanded', 'false');
    if (focusBtn) btn?.focus();
  };

  for (const group of groups) {
    const trigger = group.querySelector<HTMLButtonElement>('.nav-group-btn');
    const items = Array.from(group.querySelectorAll<HTMLAnchorElement>('.nav-menu-item'));

    const focusItem = (i: number) => {
      const n = items.length;
      items[((i % n) + n) % n]?.focus();
    };

    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const open = group.getAttribute('data-open') === 'true';
      if (open) closeGroup(group);
      else openGroup(group);
    });

    // From the trigger: Down/Enter/Space opens and moves into the menu.
    trigger?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.code === 'Space') {
        e.preventDefault();
        openGroup(group);
        focusItem(0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        openGroup(group);
        focusItem(items.length - 1);
      }
    });

    // Within the menu: roving arrow-key focus, Home/End, Escape/Tab to close.
    items.forEach((item, i) => {
      item.addEventListener('keydown', (e) => {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            focusItem(i + 1);
            break;
          case 'ArrowUp':
            e.preventDefault();
            focusItem(i - 1);
            break;
          case 'Home':
            e.preventDefault();
            focusItem(0);
            break;
          case 'End':
            e.preventDefault();
            focusItem(items.length - 1);
            break;
          case 'Escape':
            e.preventDefault();
            closeGroup(group, true);
            break;
          case 'Tab':
            closeGroup(group);
            break;
        }
      });
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('.nav-group')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
