# Public build-time configuration for Astro.
# Copy this file to `.env` for local development. These values are embedded in
# browser assets and must not contain secrets.

# PostHog project token and ingestion host. Leave the token empty to disable
# PostHog locally. Find both values in PostHog project settings.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Cloudflare Turnstile site key for contribution forms.
PUBLIC_TURNSTILE_SITE_KEY=
